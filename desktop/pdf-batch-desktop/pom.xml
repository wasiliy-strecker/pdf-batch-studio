<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.appfabrik.pdfbatch</groupId>
    <artifactId>pdf-batch-community</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>pdf-batch-desktop</artifactId>
  <name>PDF Batch Desktop</name>
  <description>Offline JavaFX client for PDF Batch Community.</description>

  <dependencies>
    <dependency>
      <groupId>de.appfabrik.pdfbatch</groupId>
      <artifactId>pdf-batch-core</artifactId>
    </dependency>
    <dependency>
      <groupId>de.appfabrik.pdfbatch</groupId>
      <artifactId>pdf-batch-document</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.maven.plugin.version}</version>
        <configuration>
          <mainClass>de.appfabrik.pdfbatch.desktop.DesktopLauncher</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
