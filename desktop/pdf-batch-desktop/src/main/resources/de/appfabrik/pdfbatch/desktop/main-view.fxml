<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<VBox fx:id="rootPane" prefWidth="1240" prefHeight="860" stylesheets="@desktop.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="18">
        <VBox spacing="3"><Label text="APPFABRIK  /  OPEN SOURCE" styleClass="eyebrow"/>
            <Label text="PDF Batch Studio" styleClass="app-title"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="100% OFFLINE" styleClass="offline-badge"/>
        <ComboBox fx:id="languagePicker" prefWidth="112"/>
    </HBox>
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="homeTab" text="Start" userData="home">
            <ScrollPane fitToWidth="true"><VBox styleClass="home-content" spacing="24">
                <VBox spacing="10"><Label text="PDFs in Serie. In wenigen Schritten." userData="welcome" styleClass="hero-title"/>
                    <Label userData="welcomeCopy" wrapText="true" styleClass="body-copy"/>
                    <Button userData="newProject" onAction="#newProject" styleClass="primary-button"/></VBox>
                <HBox spacing="20">
                    <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="01 / DEMO" styleClass="section-kicker"/>
                        <Label userData="certificate" styleClass="section-title"/>
                        <Label userData="certificateCopy" wrapText="true" styleClass="body-copy"/>
                        <Button fx:id="certificateDemoButton" userData="tryExample" onAction="#certificateDemo" styleClass="primary-button"/>
                    </VBox>
                    <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="02 / DEMO" styleClass="section-kicker"/>
                        <Label userData="letter" styleClass="section-title"/>
                        <Label userData="letterCopy" wrapText="true" styleClass="body-copy"/>
                        <Button userData="tryExample" onAction="#letterDemo" styleClass="primary-button"/>
                    </VBox>
                </HBox>
                <VBox spacing="14" styleClass="card">
                    <Label userData="projects" styleClass="section-title"/>
                    <ComboBox fx:id="projectPicker" maxWidth="Infinity"/>
                    <FlowPane hgap="10" vgap="10">
                        <Button userData="openProject" onAction="#openProject"/>
                        <Button userData="duplicate" onAction="#duplicateProject"/>
                        <Button userData="delete" onAction="#deleteProject"/>
                        <Button userData="importProject" onAction="#importProject"/>
                        <Button userData="exportProject" onAction="#exportProject"/>
                    </FlowPane>
                    <Label userData="projectPrivacy" wrapText="true" styleClass="hint"/>
                </VBox>
            </VBox></ScrollPane>
        </Tab>
        <Tab fx:id="workTab" userData="workspace" text="Arbeitsbereich">
            <SplitPane dividerPositions="0.51">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox spacing="16" styleClass="workspace-column">
                    <VBox spacing="10" styleClass="card">
                        <Label userData="stepFiles" styleClass="section-kicker"/>
                        <TextField fx:id="projectNameField"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="templateButton" userData="choosePdf" onAction="#chooseTemplate"/>
                            <Label fx:id="templatePathLabel" wrapText="true" styleClass="file-label"/>
                        </HBox>
                        <PasswordField fx:id="templatePassword"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="csvButton" userData="chooseData" onAction="#chooseCsv"/>
                            <Label fx:id="csvPathLabel" wrapText="true" styleClass="file-label"/>
                        </HBox>
                        <ComboBox fx:id="sheetPicker" maxWidth="Infinity"/>
                        <Label userData="excelHint" wrapText="true" styleClass="hint"/>
                        <Button fx:id="inspectButton" userData="inspect" onAction="#inspectFiles" styleClass="primary-button"/>
                        <TableView fx:id="dataTable" prefHeight="145"/>
                    </VBox>
                    <VBox spacing="10" styleClass="card">
                        <Label userData="stepMapping" styleClass="section-kicker"/>
                        <Label fx:id="inspectionLabel" styleClass="hint" wrapText="true"/>
                        <VBox fx:id="mappingRows" spacing="8"/>
                        <Label userData="filename" styleClass="field-label"/>
                        <TextField fx:id="filenamePatternField"/>
                        <Label userData="filenameHint" styleClass="hint" wrapText="true"/>
                        <FlowPane hgap="8" vgap="8">
                            <Button fx:id="preflightButton" userData="preflight" onAction="#preflight"/>
                            <Button fx:id="previewButton" userData="preview" onAction="#generatePreview" styleClass="primary-button"/>
                            <Button fx:id="saveProjectButton" userData="saveProject" onAction="#saveProject"/>
                        </FlowPane>
                        <Label fx:id="validationLabel" styleClass="hint" wrapText="true"/>
                        <ListView fx:id="issuesList" prefHeight="100" visible="false" managed="false"/>
                    </VBox>
                    <VBox spacing="10" styleClass="card">
                        <Label userData="stepOutput" styleClass="section-kicker"/>
                        <CheckBox fx:id="folderExport" userData="folderExport"/>
                        <PasswordField fx:id="outputPassword"/>
                        <Button fx:id="outputButton" userData="chooseOutput" onAction="#chooseOutput"/>
                        <TextField fx:id="outputPathField" editable="false"/>
                        <Button fx:id="startButton" userData="start" onAction="#startBatch" styleClass="primary-button"/>
                    </VBox>
                    <Button fx:id="resetButton" userData="newBatch" onAction="#resetWorkflow"/>
                </VBox></ScrollPane>
                <VBox spacing="14" styleClass="preview-column">
                    <VBox spacing="8" styleClass="status-card">
                        <Label fx:id="statusLabel" styleClass="status-title"/>
                        <ProgressBar fx:id="progressBar" maxWidth="Infinity"/>
                        <Label fx:id="progressDetailLabel" wrapText="true" styleClass="hint"/>
                        <Button fx:id="cancelButton" userData="cancel" onAction="#cancelBatch"/>
                    </VBox>
                    <VBox spacing="10" styleClass="preview-card" VBox.vgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label userData="row"/><Spinner fx:id="rowPicker" prefWidth="82"/>
                            <Label userData="page"/><Spinner fx:id="pagePicker" prefWidth="75"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="zoomPicker" minWidth="110" prefWidth="110"/>
                        </HBox>
                        <Label fx:id="previewStateLabel" styleClass="hint" wrapText="true"/>
                        <ScrollPane pannable="true" VBox.vgrow="ALWAYS" styleClass="preview-surface">
                            <StackPane styleClass="paper-padding"><ImageView fx:id="previewImage" fitWidth="460" preserveRatio="true" smooth="true"/></StackPane>
                        </ScrollPane>
                    </VBox>
                    <VBox fx:id="resultBox" spacing="8" styleClass="result-box" visible="false" managed="false">
                        <Label userData="resultReady" styleClass="section-title"/>
                        <Label fx:id="resultLabel" wrapText="true"/>
                        <FlowPane hgap="8" vgap="8">
                            <Button fx:id="saveResultButton" userData="saveResult" onAction="#saveResult"/>
                            <Button fx:id="openZipButton" userData="openResult" onAction="#openResultZip"/>
                            <Button fx:id="openFolderButton" userData="openFolder" onAction="#openResultFolder"/>
                        </FlowPane>
                    </VBox>
                </VBox>
            </SplitPane>
        </Tab>
        <Tab fx:id="historyTab" userData="history" text="Verlauf">
            <VBox spacing="16" styleClass="home-content">
                <Label userData="history" styleClass="hero-title"/>
                <Label userData="historyHint" styleClass="hint" wrapText="true"/>
                <ListView fx:id="historyList" VBox.vgrow="ALWAYS"/>
                <FlowPane hgap="10" vgap="10">
                    <Button userData="refresh" onAction="#refreshLibrary"/>
                    <Button userData="openResult" onAction="#openHistoryResult"/>
                    <Button userData="reuseProject" onAction="#reuseProject"/>
                    <Button userData="errors" onAction="#historyErrors"/>
                    <Button userData="clearHistory" onAction="#clearHistory"/>
                </FlowPane>
            </VBox>
        </Tab>
    </TabPane>
    <VBox fx:id="errorBox" spacing="3" styleClass="error-box" visible="false" managed="false">
        <Label fx:id="errorCodeLabel" styleClass="error-code"/><Label fx:id="errorMessageLabel" wrapText="true"/>
    </VBox>
    <Label fx:id="operationLabel" styleClass="footer"/>
</VBox>
